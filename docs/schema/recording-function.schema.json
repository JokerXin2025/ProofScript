{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofscript.local/schema/recording-function.json",
  "title": "ProofScript computation function recording",
  "$comment": "This is the function provenance object inside a computation component. It shares native expression encoding with proof documents. This schema validates shape only; the decoder additionally checks reference ownership, structural postorder and exact root targets. Metadata values are opaque scalars.",
  "type": "object",
  "required": [
    "declaration",
    "type",
    "expression",
    "implementation",
    "expressions",
    "expressionRoots"
  ],
  "properties": {
    "declaration": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "expression": {
      "$ref": "recording-proof.schema.json#/$defs/exprRef"
    },
    "implementation": {
      "$ref": "recording-proof.schema.json#/$defs/exprRef"
    },
    "expressions": {
      "$ref": "recording-proof.schema.json#/$defs/expressions"
    },
    "expressionRoots": {
      "const": [
        [
          "expression"
        ],
        [
          "implementation"
        ]
      ]
    }
  },
  "additionalProperties": false
}
