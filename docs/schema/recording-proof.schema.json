{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofscript.local/schema/recording-proof-0.1.0.json",
  "title": "ProofScript recording proof document 0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "module",
    "code"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string"
    },
    "expressions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^e[0-9]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "isProp"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "isProp": {
            "type": "boolean"
          }
        }
      }
    },
    "proof": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "dependentRequired": {
    "proof": [
      "expressions"
    ]
  },
  "additionalProperties": false,
  "$defs": {
    "expressionRef": {
      "type": "object",
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^e[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "record": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "_goal_"
          ],
          "properties": {
            "_goal_": {
              "$ref": "#/$defs/expressionRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "_ruleId"
          ],
          "properties": {
            "_ruleId": {
              "type": "string",
              "minLength": 1
            },
            "branches": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "proof"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "proof": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/record"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
