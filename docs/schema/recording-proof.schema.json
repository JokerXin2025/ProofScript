{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofscript.local/schema/recording-proof-0.4.0.json",
  "title": "ProofScript recording proof document 0.4.0",
  "$comment": "This schema validates shape only. The decoder additionally checks contiguous expression IDs, reference ownership and structural postorder, unique valid root paths, exact root targets, and invocation contract coverage and bindings. Only expressionRoots authorizes entry from proof data into the expression graph; unlisted JSON remains literal data. Nodes encode native Lean expressions. Metadata contains only opaque scalar values and one structural expr edge; syntax values and empty metadata wrappers are omitted. Parameter and value recording do not collect literature references; rendering configuration dependencies are resolved separately.",
  "type": "object",
  "required": ["schemaVersion", "module", "code", "statement", "expressions", "expressionRoots"],
  "properties": {
    "schemaVersion": {"const": "0.4.0"},
    "module": {"type": "string", "minLength": 1},
    "code": {"type": "string"},
    "statement": {"$ref": "#/$defs/statement"},
    "expressions": {"$ref": "#/$defs/expressions"},
    "expressionRoots": {"type": "array", "items": {"$ref": "#/$defs/expressionRootPath"}, "uniqueItems": true},
    "proof": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
  },
  "dependentRequired": {
    "statement": ["expressions", "expressionRoots"],
    "proof": ["expressions", "expressionRoots"],
    "expressions": ["statement", "expressionRoots"],
    "expressionRoots": ["statement", "expressions"]
  },
  "additionalProperties": false,
  "$defs": {
    "statement": {
      "type": "object",
      "required": ["parameters", "conditions", "conclusion"],
      "additionalProperties": false,
      "properties": {
        "parameters": {"type": "array", "items": {
          "type": "object", "required": ["variable", "type", "instance"], "additionalProperties": false,
          "properties": {"variable": {"$ref": "#/$defs/exprRef"}, "type": {"$ref": "#/$defs/exprRef"}, "instance": {"type": "boolean"}}
        }},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/exprRef"}},
        "conclusion": {"$ref": "#/$defs/exprRef"}
      }
    },
    "nat": {"type": "integer", "minimum": 0},
    "binderInfo": {"enum": ["default", "implicit", "strictImplicit", "instImplicit"]},
    "exprId": {"type": "string", "pattern": "^e(0|[1-9][0-9]*)$"},
    "exprRef": {
      "type": "object",
      "required": ["$ref"],
      "properties": {"$ref": {"$ref": "#/$defs/exprId"}},
      "additionalProperties": false
    },
    "jsonPathPart": {"anyOf": [{"type": "string"}, {"$ref": "#/$defs/nat"}]},
    "jsonPath": {"type": "array", "items": {"$ref": "#/$defs/jsonPathPart"}},
    "expressionRootPath": {
      "anyOf": [{"$ref": "#/$defs/proofRootPath"}, {"type": "array", "prefixItems": [{"const": "statement"}], "items": {"$ref": "#/$defs/jsonPathPart"}, "minItems": 2}]
    },
    "proofRootPath": {
      "type": "array",
      "prefixItems": [{"const": "proof"}, {"$ref": "#/$defs/nat"}],
      "items": {"$ref": "#/$defs/jsonPathPart"},
      "minItems": 3
    },
    "expressions": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/exprId"},
      "additionalProperties": {"$ref": "#/$defs/exprNode"}
    },
    "exprNode": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "index"],
          "properties": {"kind": {"const": "bvar"}, "index": {"$ref": "#/$defs/nat"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {"kind": {"const": "fvar"}, "id": {"type": "string"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {"kind": {"const": "mvar"}, "id": {"type": "string"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "level"],
          "properties": {"kind": {"const": "sort"}, "level": {"$ref": "#/$defs/level"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name", "levels"],
          "properties": {
            "kind": {"const": "const"},
            "name": {"type": "string"},
            "levels": {"type": "array", "items": {"$ref": "#/$defs/level"}}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "fn", "arg"],
          "properties": {
            "kind": {"const": "app"},
            "fn": {"$ref": "#/$defs/exprRef"},
            "arg": {"$ref": "#/$defs/exprRef"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name", "type", "body", "binderInfo"],
          "properties": {
            "kind": {"const": "lam"},
            "name": {"type": "string"},
            "type": {"$ref": "#/$defs/exprRef"},
            "body": {"$ref": "#/$defs/exprRef"},
            "binderInfo": {"$ref": "#/$defs/binderInfo"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name", "type", "body", "binderInfo"],
          "properties": {
            "kind": {"const": "forall"},
            "name": {"type": "string"},
            "type": {"$ref": "#/$defs/exprRef"},
            "body": {"$ref": "#/$defs/exprRef"},
            "binderInfo": {"$ref": "#/$defs/binderInfo"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name", "type", "value", "body", "nondep"],
          "properties": {
            "kind": {"const": "let"},
            "name": {"type": "string"},
            "type": {"$ref": "#/$defs/exprRef"},
            "value": {"$ref": "#/$defs/exprRef"},
            "body": {"$ref": "#/$defs/exprRef"},
            "nondep": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "lit"],
          "properties": {"kind": {"const": "lit"}, "lit": {"$ref": "#/$defs/literal"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "data", "expr"],
          "properties": {
            "kind": {"const": "mdata"},
            "data": {"$ref": "#/$defs/metadata"},
            "expr": {"$ref": "#/$defs/exprRef"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "typeName", "index", "expr"],
          "properties": {
            "kind": {"const": "proj"},
            "typeName": {"type": "string"},
            "index": {"$ref": "#/$defs/nat"},
            "expr": {"$ref": "#/$defs/exprRef"}
          },
          "additionalProperties": false
        }
      ]
    },
    "level": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"const": "level.zero"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "level"],
          "properties": {"kind": {"const": "level.succ"}, "level": {"$ref": "#/$defs/level"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "u", "v"],
          "properties": {
            "kind": {"const": "level.max"},
            "u": {"$ref": "#/$defs/level"},
            "v": {"$ref": "#/$defs/level"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "u", "v"],
          "properties": {
            "kind": {"const": "level.imax"},
            "u": {"$ref": "#/$defs/level"},
            "v": {"$ref": "#/$defs/level"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {"kind": {"const": "level.param"}, "name": {"type": "string"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {"kind": {"const": "level.mvar"}, "id": {"type": "string"}},
          "additionalProperties": false
        }
      ]
    },
    "literal": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "literal.nat"}, "value": {"$ref": "#/$defs/nat"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "literal.str"}, "value": {"type": "string"}},
          "additionalProperties": false
        }
      ]
    },
    "record": {
      "type": "object",
      "required": ["$ruleId"],
      "properties": {
        "$ruleId": {"type": "string", "minLength": 1},
        "$goal_before": {
          "anyOf": [
            {"$ref": "#/$defs/exprRef"},
            {"type": "null"}
          ]
        },
        "$goal_after": {
          "anyOf": [
            {"$ref": "#/$defs/exprRef"},
            {"type": "null"}
          ]
        },
        "$branches": {"type": "array", "items": {"$ref": "#/$defs/branch"}}
      },
      "additionalProperties": true
    },
    "branch": {
      "type": "object",
      "required": ["name", "proof"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "proof": {"type": "array", "items": {"$ref": "#/$defs/record"}}
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "boolean", "integer"]}
    }
  }
}
