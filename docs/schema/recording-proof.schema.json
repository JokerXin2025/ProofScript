{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofscript.local/schema/recording-proof-0.0.0.json",
  "title": "ProofScript recording proof document 0.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "module",
    "code"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.0.0"
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string"
    },
    "expressions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^e[0-9]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "isProp"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "isProp": {
            "type": "boolean"
          }
        }
      }
    },
    "proof": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "dependentRequired": {
    "proof": [
      "expressions"
    ]
  },
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "_ruleId"
      ],
      "properties": {
        "_ruleId": {
          "type": "string",
          "minLength": 1
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "proof"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "proof": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/record"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  }
}
